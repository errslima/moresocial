# Names and placeholders only. In production these go in /srv/moresocial/runtime.env and
# secret FILES in /srv/moresocial/secrets (see docs/operator-setup.md). Never commit values.
MORESOCIAL_MODE=production
PUBLIC_ORIGIN=https://1f517.com
BASE_PATH=/moresocial
BETA_ALLOWLIST=first.tester@example.com,second.tester@example.com
AI_PROVIDER=anthropic            # anthropic | none (fake is refused in production)
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_REFUSAL_FALLBACKS=1
EMBEDDING_MODEL=voyage-3.5
EMBEDDING_DIMENSION=1024
AI_DAILY_TOKENS_PER_WORKSPACE=400000
AI_DAILY_TOKENS_GLOBAL=2000000
AI_CONCURRENCY=2
WHATSAPP_CONNECTOR_CAP=2
SYNC_POLL_SECONDS=300
SESSION_DAYS=30
# Set by compose (container paths of mounted secret files):
# GOOGLE_CLIENT_FILE=/run/secrets/google_auth.json
# ENCRYPTION_KEY_FILE=/run/secrets/encryption_key
# OPERATOR_KEY_FILE=/run/secrets/operator_key
# DATABASE_PASSWORD_FILE=/run/secrets/db_password
# ANTHROPIC_API_KEY_FILE=/run/secrets/anthropic_api_key
# VOYAGE_API_KEY_FILE=/run/secrets/voyage_api_key
